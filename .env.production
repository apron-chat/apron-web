# The reference server (testing and demos), for every `vite build`: web.apron.chat,
# Workers Builds Previews, and local builds. Not used by `npm run dev` or the tests.
# To build for another server, set VITE_DEFAULT_SERVER_URL in .env.production.local
# or on the command line; empty means same-origin /ws. See the README.
VITE_DEFAULT_SERVER_URL=wss://server.apron.chat/
