{
	"name": "@apron/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"icons": "node scripts/icons.js",
		"design:bundle": "node scripts/design-bundle.js",
		"qa": "node scripts/qa/cli.js",
		"e2e": "APRON_PREVIEW=1 vite build && playwright test --config e2e/playwright.config.ts",
		"e2e:short": "APRON_PREVIEW=1 vite build && E2E_TIER=short playwright test --config e2e/playwright.config.ts"
	},
	"devDependencies": {
		"@playwright/test": "~1.64.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"axe-core": "^4.14.0",
		"fake-indexeddb": "6.2.5",
		"jsdom": "^30.1.1",
		"pixelmatch": "^7.2.0",
		"playwright-core": "~1.64.1",
		"pngjs": "^7.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@emoji-mart/data": "^1.2.1",
		"@lucide/svelte": "^1.48.0",
		"dompurify": "^3.4.16",
		"emoji-mart": "^5.6.0",
		"highlight.js": "^11.12.0",
		"markdown-it": "^15.0.2",
		"svelte-dnd-action": "^0.9.80"
	}
}
